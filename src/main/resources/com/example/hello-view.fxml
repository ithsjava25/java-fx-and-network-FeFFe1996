<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.HelloController">
    <Label fx:id="messageLabel" text="Welcome to the messageboard" alignment="CENTER"/>
    <ListView fx:id="messageBoard" prefWidth="200.0"  />
    <VBox fx:id="newMessage" alignment="CENTER">
        <Label text="your message"/>
        <TextField fx:id="msg" maxWidth="500" prefHeight="30" />
        <Button fx:id="submitButton" text="Submit" onAction="#submitMsg"/>
    </VBox>
</VBox>
